# ===================================================================
# Example Nginx reverse-proxy configuration
# Site: https://card.univ.edu/gaoxiaojiaoshidianzimingpian
#
# WebSocket: This application does NOT use WebSocket.
#            No upgrade / connection headers are needed.
# ===================================================================

upstream app_backend {
    server 127.0.0.1:8080;        # or  app:8080  if inside docker network
    keepalive 32;
}

server {
    listen       80;
    server_name  card.univ.edu;
    return 301   https://$host$request_uri;
}

server {
    listen       443 ssl http2;
    server_name  card.univ.edu;

    # --- TLS (replace with real cert paths) ---
    ssl_certificate      /etc/nginx/ssl/card.univ.edu.crt;
    ssl_certificate_key  /etc/nginx/ssl/card.univ.edu.key;
    ssl_protocols        TLSv1.2 TLSv1.3;

    client_max_body_size 1000m;     # match Spring Boot max-file-size

    # --- Uploaded files (served directly by Nginx, bypassing Tomcat) ---
    # If UPLOAD_BASE_PATH is /data/upload, files live in /data/upload/upload/
    location /gaoxiaojiaoshidianzimingpian/upload/ {
        alias /data/upload/upload/;
        expires 7d;
        access_log off;
    }

    # --- Reverse proxy to Spring Boot ---
    location /gaoxiaojiaoshidianzimingpian {
        proxy_pass         http://app_backend/gaoxiaojiaoshidianzimingpian;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_connect_timeout  60s;
        proxy_read_timeout     120s;
        proxy_send_timeout     120s;
    }

    # --- Default: reject everything else ---
    location / {
        return 404;
    }
}
