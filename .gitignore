# ---- Build output ----
target/
build/
out/

# ---- IDE ----
.idea/
*.iml
*.iws
*.ipr
.vscode/
.project
.classpath
.settings/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Node / Frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ---- Secrets & local env ----
.env
.env.local
.env.production
*.env

# ---- Logs ----
*.log
logs/

# ---- Uploaded files (user-generated, never commit) ----
# Keep the directory structure but ignore contents
static/upload/*
!static/upload/.gitkeep
upload/*
!upload/.gitkeep

# ---- Docker volumes ----
data/
mysql-data/

# ---- SSL certs (never commit) ----
deploy/ssl/*.pem
deploy/ssl/*.key
deploy/ssl/*.crt
!deploy/ssl/.gitkeep
