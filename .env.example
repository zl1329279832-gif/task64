# ==================================================
# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit secrets.
# ==================================================

# --- Database ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gaoxiaojiaoshidianzimingpian
DB_USER=root
DB_PASSWORD=CHANGE_ME_strong_password_here

# --- Upload directory ---
# Absolute path on the host / container.
# In docker-compose this is mapped to a named volume.
# For NAS: mount NFS to this path on the host, then bind-mount into the container.
UPLOAD_BASE_PATH=/data/upload
