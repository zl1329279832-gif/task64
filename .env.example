# ============================================================
# 环境变量模板 — 复制为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# Spring 激活的 profile
SPRING_PROFILES_ACTIVE=prod

# 数据库连接
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gaoxiaojiaoshidianzimingpian
DB_USER=gxjs_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# 上传文件存储根目录（挂载 NAS 或本地持久化目录）
UPLOAD_BASE_PATH=/data/uploads

# MySQL root 密码（仅 docker-compose 使用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_here
